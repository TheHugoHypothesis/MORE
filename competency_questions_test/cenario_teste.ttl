        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
      </owl:unionOf>
    </owl:Class>
  </rdfs:range>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">are constant quale of</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is constant quale of</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the value of the constant quale relation taken</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantQualeOf is the constant version of Temporary Quale Of which is a ternary relation among a physical region x, a physical quality y and a time interval t or among an abstract region x, an abstract quality y and a time interval t. It relates the quality to its quale (position) at a certain time.
In this constant version, the region x is the quale of the quality y during the whole existence of y.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant quale of</rdfs:label>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">are constant quale of</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is constant quale of</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">the value of the constant quale relation taken</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantQualeOf is the constant version of Temporary Quale Of which is a ternary relation among a physical region x, a physical quality y and a time interval t or among an abstract region x, an abstract quality y and a time interval t. It relates the quality to its quale (position) at a certain time.
In this constant version, the region x is the quale of the quality y during the whole existence of y.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant quale of</rdfs:label>
</owl:ObjectProperty>

