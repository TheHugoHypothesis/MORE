  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Space Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#GenderRegion">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#GenderQuality"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="en">An abstract region that defines the space of possible gender identities.</rdfs:comment>
  <rdfs:label xml:lang="en">Gender Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Person">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_nationality"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Nation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#GenderQuality"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_nationality"/>
      <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Nation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:onClass rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#GenderQuality"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_age"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#positiveInteger"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_name"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="en">A person (pl.: people or persons, depending on context) is a being who has certain capacities or attributes such as reason, morality, consciousness or self-consciousness, and being a part of a culturally established form of social relations such as kinship, ownership of property, or legal responsibility. 
(https://en.wikipedia.org/wiki/Person)</rdfs:comment>
  <rdfs:label xml:lang="en">Person</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#DocumentaryGenre">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre"/>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionGenre"/>
  <rdfs:comment xml:lang="en">A documentary film (often described simply as a documentary) is a nonfiction, motion picture intended to "document reality, primarily for instruction, education or maintaining a historical record"(https://en.wikipedia.org/wiki/Documentary_film)</rdfs:comment>
  <rdfs:label xml:lang="en">Documentary Genre</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <owl:disjointWith>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Award"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role"/>
      </owl:unionOf>
    </owl:Class>
  </owl:disjointWith>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#DocumentaryGenre"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionGenre"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdfs:comment xml:lang="en">A film genre is a stylistic or thematic category for motion pictures based on similarities either in the narrative elements, aesthetic approach, or the emotional response to the film.(https://en.wikipedia.org/wiki/Film_genre)</rdfs:comment>
  <rdfs:label xml:lang="en">Film Genre</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionGenre">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre"/>
  <rdfs:comment xml:lang="en">Broad category of film genres that includes stories that are not primarily documentary, involving fictional narratives or dramatized events.</rdfs:comment>
  <rdfs:label xml:lang="en">Fiction Genre</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#contains_role"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#DirectorRole"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_genre"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_nationality"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Nation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_nationality"/>
      <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Nation"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_production_date"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_title"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Award"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role"/>
      </owl:unionOf>
    </owl:Class>
  </owl:disjointWith>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Documentary"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionMovie"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdfs:comment xml:lang="en">A movie or film is a type of visual art that uses images and sounds to tell stories, express ideas, or teach people something. (https://simple.wikipedia.org/wiki/Movie)</rdfs:comment>
  <rdfs:label xml:lang="en">Movie</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#UserRating">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#is_about"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#is_performed_by"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#User"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#is_about"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#is_performed_by"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#User"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_score"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_timestamp"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTimeStamp"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="en">The act performed by an user to evaluate something in terms of a metric rating.</rdfs:comment>
  <rdfs:label xml:lang="en">User Rating</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#GenderQuality">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Person"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <owl:onClass rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Person"/>
      <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="en">Gender is the range of social, psychological, cultural, and behavioral aspects of being a man (or boy), woman (or girl), or portraying a third gender. (https://en.wikipedia.org/wiki/Gender)</rdfs:comment>
  <rdfs:label xml:lang="en">Gender Quality</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Award">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <owl:disjointWith>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role"/>
      </owl:unionOf>
    </owl:Class>
  </owl:disjointWith>
  <rdfs:comment xml:lang="en">An award, sometimes called a distinction, is given to a recipient as a token of recognition of excellence in a certain field. (https://en.wikipedia.org/wiki/Award)</rdfs:comment>
  <rdfs:label xml:lang="en">Award</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#User">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialAgent"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_email"/>
      <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="en">A user is a person who uses a computer or network service. (https://en.wikipedia.org/wiki/User)</rdfs:comment>
  <rdfs:label xml:lang="en">User</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#ActorRole">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role"/>
  <rdfs:comment xml:lang="en">A role which is performed by as a actor.</rdfs:comment>
  <rdfs:label xml:lang="en">Actor Role</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <owl:disjointWith>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Award"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#FilmGenre"/>
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
      </owl:unionOf>
    </owl:Class>
  </owl:disjointWith>
  <rdfs:comment xml:lang="en">A role (also rôle or social role) is a set of connected behaviors, rights, obligations, beliefs, and norms as conceptualized by people in a social situation. (https://en.wikipedia.org/wiki/Role)</rdfs:comment>
  <rdfs:label xml:lang="en">Role</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Documentary">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_genre"/>
          <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#DocumentaryGenre"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#contains_role"/>
          <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#DirectorRole"/>
        </owl:Restriction>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#contains_role"/>
          <owl:onClass rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#DirectorRole"/>
          <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionMovie"/>
  <rdfs:comment xml:lang="en">A movie that belongs to the DocumentaryGenre. It is defined by its factual nature and, within this system, follows specific production rules.</rdfs:comment>
  <rdfs:label xml:lang="en">Documentary</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionMovie">
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#has_genre"/>
          <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#FictionGenre"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Movie"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#contains_role"/>
      <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#ActorRole"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:comment xml:lang="en">A movie that belongs to any genre within the FictionGenre category. It represents the standard cinematic production involving dramatization.</rdfs:comment>
  <rdfs:label xml:lang="en">Fiction Movie</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#Nation">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Society"/>
  <rdfs:comment xml:lang="en">A nation is a type of social organization where a collective identity—a national identity—has emerged from a combination of shared features across a given population, such as language, history, ethnicity, culture, territory, or society. (https://en.wikipedia.org/wiki/Nation)</rdfs:comment>
  <rdfs:label xml:lang="en">Nation</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#DirectorRole">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role"/>
  <rdfs:comment xml:lang="en">A role which is performed by as a director.</rdfs:comment>
  <rdfs:label xml:lang="en">Director Role</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#RatingScale">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <rdfs:comment xml:lang="en">A decimal metric space that delimits the acceptable values ​​for measuring user rating.</rdfs:comment>
  <rdfs:label xml:lang="en">Rating Scale</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#GlobalRating">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
  <rdfs:comment xml:lang="en">A rating is an evaluation or assessment of something, in terms of a metric Rating or rating system, that represents an global users evaluation by some metric.</rdfs:comment>
  <rdfs:label xml:lang="en">Global Rating</rdfs:label>
</owl:Class>

<owl:Class rdf:about="http://www.semanticweb.org/ontologies/2026/3/MOREO#ScreenwriterRole">
  <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#Role"/>
  <rdfs:comment xml:lang="en">A role which is performed by as a screenwriter.</rdfs:comment>
  <rdfs:label xml:lang="en">Screenwriter Role</rdfs:label>
</owl:Class>

