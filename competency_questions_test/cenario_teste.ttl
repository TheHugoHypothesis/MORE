  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depends on</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depends on</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depended on</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specific Constant Dependence</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specificallyDependsOn is a binary relation between two entities x, y present in time, i.e., endurants, perdurants or qualities, with the intended interpretation that the existence of x specifically and constantly depends on the existence of y.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depends on</rdfs:label>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depends on</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depends on</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depended on</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Specific Constant Dependence</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specificallyDependsOn is a binary relation between two entities x, y present in time, i.e., endurants, perdurants or qualities, with the intended interpretation that the existence of x specifically and constantly depends on the existence of y.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">specifically depends on</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantlyOverlaps">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:range rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:range rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:propertyChainAxiom>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:propertyChainAxiom>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlaps</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlaps</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlapped</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantlyOverlaps holds between two endurants that share a constant part, and are such that the time intervals at which they are temporally located overlap.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlaps</rdfs:label>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlaps</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlaps</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlapped</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantlyOverlaps holds between two endurants that share a constant part, and are such that the time intervals at which they are temporally located overlap.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly overlaps</rdfs:label>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantParticipantOf">
  <rdfs:subPropertyOf>
    <rdf:Description>
      <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
    </rdf:Description>
  </rdfs:subPropertyOf>
  <rdfs:domain rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:range rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  <rdfs:subPropertyOf>
    <rdf:Description>
      <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
    </rdf:Description>
  </rdfs:subPropertyOf>
  <rdfs:domain rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:range rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">are constant participants of</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is constant participant of</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly participated</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantParticipantOf is the constant version of Participation which is a ternary relation between an endurant x, a perdurant y, and a time interval t. The intended interpretation is that x participates in y at time t. Every perdurant has at least an endurant that participates in it, and every endurant participates in some perdurant. 
In this constant version, the endurant x participates in the perdurant y during the whole existence of y.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant participation of</rdfs:label>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">are constant participants of</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is constant participant of</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly participated</ace_:TV_vbg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantParticipantOf is the constant version of Participation which is a ternary relation between an endurant x, a perdurant y, and a time interval t. The intended interpretation is that x participates in y at time t. Every perdurant has at least an endurant that participates in it, and every endurant participates in some perdurant. 
In this constant version, the endurant x participates in the perdurant y during the whole existence of y.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant participation of</rdfs:label>
</owl:ObjectProperty>

