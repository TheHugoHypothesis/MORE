              </rdf:first>
              <rdf:rest>
                <swrl:AtomList>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#is_role_of"/>
                      <swrl:argument1 rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#r"/>
                      <swrl:argument2 rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#p"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <swrl:AtomList>
                      <rdf:first>
                        <swrl:IndividualPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#is_played_in"/>
                          <swrl:argument1 rdf:resource="http://www.semanticweb.org/ontologies/2026/3/MOREO#r"/>
