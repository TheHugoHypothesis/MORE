  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Society is a collective agentive social object (examples: a nation, the FCA Group, Apple, the European Central Bank).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Society</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">societies</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">society</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Society is a collective agentive social object (examples: a nation, the FCA Group, Apple, the European Central Bank).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Society</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion">
