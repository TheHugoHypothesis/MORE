  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantProperPartOf is the irreflexive specialization of the constantPartOf relation.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constant proper part of</rdfs:label>
  <ace_:TV_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">are constant proper part of</ace_:TV_pl>
  <ace_:TV_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">is constant proper part of</ace_:TV_sg>
  <ace_:TV_vbg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">constantly divided into proper parts</ace_:TV_vbg>
