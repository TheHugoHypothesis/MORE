  <term:contributor rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Radija Ingrid Silva (15675172)</term:contributor>
  <rdfs:label xml:lang="en">MOREO (MOvie REcommendation Ontology)</rdfs:label>
</owl:Ontology>

