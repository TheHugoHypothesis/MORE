              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualities</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Quality is an entity that inheres in an endurant or a perdurant, and that can be perceived or measured (examples: the shape of a book, the color of a car, the size of a t-shirt, the electrical charge of a battery).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quality</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">qualities</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">quality</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Quality is an entity that inheres in an endurant or a perdurant, and that can be perceived or measured (examples: the shape of a book, the color of a car, the size of a t-shirt, the electrical charge of a battery).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Quality</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time intervals</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time interval</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Time Interval is a temporal region which is an interval or a sum of intervals. A Time Interval can be atomic, i.e., instantaneous. (examples: the first second of your life,  the Cretaceous time period, the time interval of all winters of the third millennium).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time Interval</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time intervals</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">time interval</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Time Interval is a temporal region which is an interval or a sum of intervals. A Time Interval can be atomic, i.e., instantaneous. (examples: the first second of your life,  the Cretaceous time period, the time interval of all winters of the third millennium).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Time Interval</rdfs:label>
</owl:Class>

