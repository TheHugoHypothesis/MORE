<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of a time interval is a time interval.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every time interval is a temporal region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Region"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every temporal region is a region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad46 for dQt (together with the axiom "Every quality is direct quality of a particular")</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every temporal quality is a direct quality of a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#qualeOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad55</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every temporal quality has some particular as quale.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every temporal quality is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalLocation"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#qualeOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad53</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every temporal location has some time interval as quale.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalLocation"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every temporal location is a temporal quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every stative is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of a state is a state.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every state is a stative.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpatialLocation"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every spatial location is a physical quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of a space region is a space region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has a space region as part is a space region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpatialLocation"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has a space region as constant quale is a spatial location.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpaceRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every space region is a physical region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Society"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every society is an agentive social object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointUnionOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The classes SocialObject, NonAgentiveSocialObjectare all disjoint.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every social object is a non physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialAgent"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Society"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No social agent is a society.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialAgent"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every social agent is an agentive social object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Region"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointUnionOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The classes Region, AbstractRegion, TemporalRegionare all disjoint.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Region"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every region is an abstract.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointUnionOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A quality is either an abstract quality, a physical quality, or a temporal quality, and the classes AbstractQuality, PhysicalQuality, and TemporalQuality are all disjoint.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every quality is temporally located at a timeinterval.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every quality is direct quality of a particular.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Q(x)→ ∃y DQT(x,y)</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every quality is a particular.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Process"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No process is a state.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Process"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every process is a stative.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No physical region is a temporal region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has a physical region as constant quale is a physical quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Region"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every physical region is a region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No physical quality is a temporal quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant quale of a physical quality is a physical region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad47 for dQt (together with the axiom "Every quality is direct quality of a particular")</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every physical quality is a direct quality of a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every physical quality is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointUnionOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentivePhysicalObject"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The classes PhysicalObject, NonAgentivePhysicalObjectare all disjoint.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every physical object is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approximation of Ad50</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is direct quality of a physical endurant is a physical quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant part of a physical endurant is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant constituent of a physical endurant is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constantly constituted by a physical endurant is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpatialLocation"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approximation of Ad50</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every physical endurant has a spatial location as direct quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every physical endurant is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No perdurant is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad2 (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of a perdurant is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that overlaps a perdurant is a perdurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from Dd15, Ad2</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad49 for dQt</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is direct quality of a perdurant is a temporal quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant constituent of a perdurant is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad2  (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has a perdurant as part is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is overlapped by a perdurant is a perdurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from Dd15, Ad2</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constantly constituted by a perdurant is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalLocation"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad49 for dQt</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every perdurant has a temporal location as direct quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every perdurant is temporally located at a time interval.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every perdurant is a particular.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointUnionOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A particular is either an abstract, an endurant, a perdurant, or a quality, and the classes Abstract, Endurant, Perdurant and Quality are all disjoint.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every non physical object is a non physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No non physical endurant is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approximation of Ad51</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is direct quality of a non physical endurant is an abstract quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant part of a non physical endurant is a non physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant constituent of a non physical endurant is a non physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constantly constituted by a non physical endurant is a non physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every non physical endurant is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every non agentive social object is a social object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentivePhysicalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every non agentive physical object is a physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#MentalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No mental object is a social object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#MentalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every mental object specifically depends on an agentive physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#MentalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every mental object is a non physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Feature"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No feature is a physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Feature"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every feature is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No event is a stative.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every event is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointUnionOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#ArbitrarySum"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An endurant is either an arbitrary sum, a physical endurant or a non-physical endurant, and the classes ArbitrarySum, PhysicalEndurant and NonPhysicalEndurant are all disjoint.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No endurant is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No endurant is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every endurant is temporally located at a time interval.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every endurant is a particular.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:onProperty>
            <rdf:Description>
              <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#properPartOf"/>
            </rdf:Description>
          </owl:onProperty>
          <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd16</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No atom has a particular as proper part.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every atom is something that is an abstract or that is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every atom is a particular.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#ArbitrarySum"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No arbitrary sum is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#ArbitrarySum"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No arbitrary sum is a non physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#ArbitrarySum"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every arbitrary sum is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AmountOfMatter"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No amount of matter is a physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AmountOfMatter"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Feature"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No amount of matter is a feature.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AmountOfMatter"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every amount of matter is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No agentive social object is a non agentive social object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every agentive social object is a social object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every agentive physical object is a physical object.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every achievement is temporally located at some atomic time interval (atom)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Ad75</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every achievement is an event.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Accomplishment"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No accomplishment is an achievement.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Accomplishment"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
          <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every accomplishment is temporally located at a non-atomic temporal interval.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Ad76</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Accomplishment"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every accomplishment is an event.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract region is a temporal region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract region is a physical region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of an abstract region is an abstract region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has an abstract region as part is an abstract region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has an abstract region as a constant quale is an abstract quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Region"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every abstract region is a region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract quality is a temporal quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract quality is a physical quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant quale of an abstract quality is an abstract region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad48 for dQt</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has an abstract quality as direct quality is a non physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every abstract quality is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#disjointWith"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">No abstract is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad3 (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of an abstract is an abstract.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that overlaps an abstract is an abstract.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from Dd15, Ad3</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad3 (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has an abstract as part is an abstract.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
    </owl:Restriction>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is overlapped by an abstract is an abstract.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">from Dd15, Ad3</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Every abstract is a particular.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is the value of the temporal location relation is a time interval.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is temporally located at something is something that is an endurant or that is a perdurant or that is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything is temporally located at at most 1 thing.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd40 + Ad5</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is temporally located at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporalPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has something as temporal part is a perdurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd54 and Ad2</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporalPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd54 (third)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is temporal part of something is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporalPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is temporal part of something that is temporal part of Y then X is temporal part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporalPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd54 (third)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is temporal part of Y then X is part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is specifically depended on by something is something that is an endurant or that is a perdurant or that is a quality.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd69</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that specifically depends on something is something that is an endurant or that is a perdurant or that is a quality.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd69</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X specifically depends on something that specifically depends on Y then X specifically depends on Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#qualeOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad52</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything has something as a quale is a temporal quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#qualeOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad52</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is quale of something is a temporal region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#properPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has something as proper part is something that is an abstract or that is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#properPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is proper part of something is something that is an abstract or that is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#properPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is proper part of something that is proper part of Y then X is proper part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#properPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D14 (half)
irreflexivity impossible (property implies domain=Thing, and use of Self incompatible with transitivity)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is proper part of Y then X is part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantProperPartOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant proper part of something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantParticipantOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant participant of something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant part of something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant constituent of something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantAtomicPartOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant atomic part of something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is the value of the present at relation is a time interval.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd40, Dd30, Dd31, Dd32, Dd33</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is present at something is something that is an endurant or that is a perdurant or that is a quality.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd40, Dd30, Dd31, Dd32, Dd33</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approximation of Dd69</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is specifically depended on by something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X has something that is present at Y as part then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd28, Dd32, Dd33, Dd34, Dd40</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X has something that is present at Y as direct quality then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <rdf:Description>
              <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
            </rdf:Description>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is present at something that has Y as part then X is present at Y.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Td17</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd28, Dd32, Dd33, Dd34, Dd40</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is a direct quality of something that is present at Y then X is present at Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad1 (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is has something as part is something that is an abstract or that is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Ad1 (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is part of something is something that is an abstract or that is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is part of something that is part of Y then X is part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Ad5 and Dd15</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is part of Y then X overlaps Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#presentAt"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Approximation of half of Dd40</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is a time of presence of something which is temporally located at Y then X overlaps Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">D15 (half)</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X has something that is part of Y as part then X overlaps Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is overlapped by something is something that is an abstract or that is a perdurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Ad1 and Dd15</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that overlaps something is something that is an abstract or that is a perdurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Ad1 and Dd15</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#overlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X overlaps Y then Y overlaps X.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has something as direct quality is something that is an endurant or that is a perdurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd28, Ad38, Ad43, Ad46, Ad47, Ad48</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Dd28, Ad38</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is direct quality of something is a quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything is direct quality of at most 1 thing.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#directQualityOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is direct quality of Y then X specifically depends on Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantlyOverlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2002/07/owl#propertyChainAxiom"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <rdf:first>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
        </rdf:Description>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X has something that is a constant part of Y as constant part then X constantly overlaps Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantlyOverlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constantly overlapped by something is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantlyOverlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that constantly overlaps something is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantlyOverlaps"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X constantly overlaps Y then Y constantly overlaps X.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractQuality"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has something as constant quale is something that is an abstract quality or that is a physical quality.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantQualeOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant quale of something is something that is an abstract region or that is a physical region.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantProperPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has something as a constant proper part is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantProperPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant proper part of something is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantProperPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant proper part of something that is constant proper part of Y then X is constant proper part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantProperPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant proper part of Y then X is constant part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantParticipantOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constantly participated by something is a perdurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantParticipantOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant participant of something is an endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantParticipantOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant participant of Y then Y specifically depends on X.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that has something as constant part is an endurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd25, Ad10</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant part of something is an endurant.</rdfs:comment>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">From Dd25, Ad10</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant part of something that is constant part of Y then X is constant part of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantPartOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantlyOverlaps"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant part of Y then X constantly overlaps Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  <owl:annotatedTarget rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant constituent of something that is constant constituent of Y then X is constant constituent of Y.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subPropertyOf"/>
  <owl:annotatedTarget>
    <rdf:Description>
      <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
    </rdf:Description>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">If X is constant constituent of Y then Y specifically depends on X.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constantly constituted by something is something that is a non physical endurant or that is a perdurant or that is a physical endurant.</rdfs:comment>
</owl:Axiom>

<owl:Axiom>
  <owl:annotatedSource rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#constantConstituentOf"/>
  <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  <owl:annotatedTarget>
    <owl:Class>
      <owl:unionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
        <rdf:Description rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
      </owl:unionOf>
    </owl:Class>
  </owl:annotatedTarget>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Everything that is constant constituent of something is something that is a non physical endurant or that is a perdurant or that is a physical endurant.</rdfs:comment>
</owl:Axiom>


</rdf:RDF>
