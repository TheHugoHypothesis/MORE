  </rdfs:subClassOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal qualities</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal quality</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Temporal Quality is a quality that directly inheres to a perdurant (example: the duration of World War I, the starting time of the 2000 Olympics).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Temporal Quality</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal qualities</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal quality</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Temporal Quality is a quality that directly inheres to a perdurant (example: the duration of World War I, the starting time of the 2000 Olympics).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Temporal Quality</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Particular">
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Quality"/>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particulars</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particular</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Particular is an entity that cannot have instances, in this sense it is opposed to universals (examples: a person, a soccer game, a plan, the color red, a feeling, a fact, a theory, number forty-two).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Particular</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particulars</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">particular</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Particular is an entity that cannot have instances, in this sense it is opposed to universals (examples: a person, a soccer game, a plan, the color red, a feeling, a fact, a theory, number forty-two).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Particular</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Region">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Abstract"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AbstractRegion"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalRegion"/>
          <rdf:rest>
            <rdf:Description>
              <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalRegion"/>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regions</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">region</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Region is an abstract entity classified by a quality type and with mereological structure, the sum of all the regions of a quality type is called a quality space (examples: the color red is a region in the quality space of color, the red of a rose is a (sub)region of the red region in the quality space of color, the commercial value of 1 Euro is a region in the quality space of commercial values).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Region</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regions</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">region</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Region is an abstract entity classified by a quality type and with mereological structure, the sum of all the regions of a quality type is called a quality space (examples: the color red is a region in the quality space of color, the red of a rose is a (sub)region of the red region in the quality space of color, the commercial value of 1 Euro is a region in the quality space of commercial values).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Region</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Accomplishment">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
          <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <rdfs:subClassOf>
    <owl:Class>
      <owl:complementOf>
        <owl:Restriction>
          <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
          <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
        </owl:Restriction>
      </owl:complementOf>
    </owl:Class>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accomplishments</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accomplishment</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Accomplishment is an event which is mereologically non-atomic (examples: a conference, an ascent, a performance).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accomplishment</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accomplishments</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">accomplishment</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Accomplishment is an event which is mereologically non-atomic (examples: a conference, an ascent, a performance).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accomplishment</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">events</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Event is an anti-cumulative perdurant, i.e., a perdurant that when summed to another perdurant of the same type, gives a perdurant of a different type (examples: closing a door, reaching the top of a mountain, breaking a seal).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Event</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">events</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">event</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Event is an anti-cumulative perdurant, i.e., a perdurant that when summed to another perdurant of the same type, gives a perdurant of a different type (examples: closing a door, reaching the top of a mountain, breaking a seal).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Event</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Achievement">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Event"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#temporallyLocatedAt"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Atom"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achievements</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achievement</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Achievement is an event which is mereologically atomic (examples: reaching the summit of K2, a departure, a death).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Achievement</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achievements</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">achievement</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Achievement is an event which is mereologically atomic (examples: reaching the summit of K2, a departure, a death).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Achievement</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Agentive Physical Object is a physical object to which intentions, believes and desires are ascribed (examples: a human person as opposed to a legal person).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agentive Physical Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Agentive Physical Object is a physical object to which intentions, believes and desires are ascribed (examples: a human person as opposed to a legal person).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agentive Physical Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentivePhysicalObject"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentivePhysicalObject"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Physical Object is a physical endurant with unity criterion (examples: a person, a human body, a house, a computer).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Physical Object is a physical endurant with unity criterion (examples: a person, a human body, a house, a computer).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Physical Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive social objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive social object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Agentive Social Object is a social object to which intentions, believes and desires are ascribed (examples: a teacher, a president, a software agent, a nation).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agentive Social Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive social objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentive social object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Agentive Social Object is a social object to which intentions, believes and desires are ascribed (examples: a teacher, a president, a software agent, a nation).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Agentive Social Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <owl:disjointUnionOf>
    <rdf:Description>
      <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
      <rdf:rest>
        <rdf:Description>
          <rdf:first rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject"/>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </owl:disjointUnionOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Social Object is a non-physical object which is generically dependent on a community of agents (examples: a person in the legal sense, a client, a law, an economic system).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Social Object is a non-physical object which is generically dependent on a community of agents (examples: a person in the legal sense, a client, a law, an economic system).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentiveSocialObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive social objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive social object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Non-Agentive Social Object is a social object to which intentions, believes and desires are not ascribed (examples: a law, an economic system, a currency, an asset).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Agentive Social Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive social objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive social object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Non-Agentive Social Object is a social object to which intentions, believes and desires are not ascribed (examples: a law, an economic system, a currency, an asset).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Agentive Social Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#AmountOfMatter">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Feature"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Feature"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amounts of matter</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amount of matter</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Amount Of Matter is a physical endurant which has no unity criterion and is mereologically invariant, that is, all its part are essential parts (examples: the gold of my wedding ring, the sand used to make this glass).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amount of Matter</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amounts of matter</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">amount of matter</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Amount Of Matter is a physical endurant which has no unity criterion and is mereologically invariant, that is, all its part are essential parts (examples: the gold of my wedding ring, the sand used to make this glass).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amount of Matter</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Feature">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">features</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feature</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Feature is a physical endurant which has a unity criterion and is existentially dependent on another physical endurant, its host (examples: a hole, a bump, an object’s boundary, a stain on a t-shirt).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feature</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">features</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">feature</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Feature is a physical endurant which has a unity criterion and is existentially dependent on another physical endurant, its host (examples: a hole, a bump, an object’s boundary, a stain on a t-shirt).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Feature</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#ArbitrarySum">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Endurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalEndurant"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arbitrary sums</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arbitrary sum</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Arbitrary Sum is an endurant which is the mereological sum of at least a physical and a non-physical endurant.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arbitrary Sum</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arbitrary sums</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">arbitrary sum</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">An Arbitrary Sum is an endurant which is the mereological sum of at least a physical and a non-physical endurant.</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Arbitrary Sum</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Perdurant"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statives</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stative</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Stative is a cumulative perdurant, i.e., a perdurant that when summed to another perdurant of the same type, gives a perdurant of the same type (examples: sitting, walking, waiting).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stative</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">statives</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">stative</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Stative is a cumulative perdurant, i.e., a perdurant that when summed to another perdurant of the same type, gives a perdurant of the same type (examples: sitting, walking, waiting).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stative</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#MentalObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#specificallyDependsOn"/>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentivePhysicalObject"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Mental Object is a non-physical object which existentially depends on an agentive physical object (examples: a percept, a sense datum).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mental Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mental object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Mental Object is a non-physical object which existentially depends on an agentive physical object (examples: a percept, a sense datum).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Mental Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonPhysicalEndurant"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Non-Physical Object is a non-physical endurant with unity criterion (examples: a theory, a topic, a concept).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Physical Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Non-Physical Object is a non-physical endurant with unity criterion (examples: a theory, a topic, a concept).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Physical Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#NonAgentivePhysicalObject">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalObject"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Non-Agentive Physical Object is a physical object to which intentions, believes and desires are not ascribed (examples: a pebble, a house, a computer, a human body).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Agentive Physical Object</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive physical objects</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">non agentive physical object</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Non-Agentive Physical Object is a physical object to which intentions, believes and desires are not ascribed (examples: a pebble, a house, a computer, a human body).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Non-Agentive Physical Object</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalLocation">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#qualeOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TemporalQuality"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#qualeOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:someValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#TimeInterval"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal locations</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal location</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Temporal Location is a temporal quality of a perdurant and is specific to that perdurant, that is, two concurrent perdurants have distinct temporal locations. The temporal location is the temporal quality which has as quale the unique time interval at which the perdurant is exactly located (examples: the temporal location of World War I, the temporal location of the Anderssen-Kieseritzky chess play in 1851, the temporal location of the summers of the 20th century).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Temporal Location</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal locations</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">temporal location</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Temporal Location is a temporal quality of a perdurant and is specific to that perdurant, that is, two concurrent perdurants have distinct temporal locations. The temporal location is the temporal quality which has as quale the unique time interval at which the perdurant is exactly located (examples: the temporal location of World War I, the temporal location of the Anderssen-Kieseritzky chess play in 1851, the temporal location of the summers of the 20th century).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Temporal Location</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#SpatialLocation">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#PhysicalQuality"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spatial locations</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spatial location</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Spatial Location is the individual spatial quality of a physical endurant (examples: the spatial quality of the Earth, the spatial quality of a hole, the spatial quality of Adolf Anderssen).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial Location</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spatial locations</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">spatial location</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Spatial Location is the individual spatial quality of a physical endurant (examples: the spatial quality of the Earth, the spatial quality of a hole, the spatial quality of Adolf Anderssen).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Spatial Location</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Process">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">processes</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">process</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Process is a stative perdurant such that at some temporal scale some parts are of a different type  (examples: running, writing).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">processes</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">process</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Process is a stative perdurant such that at some temporal scale some parts are of a different type  (examples: running, writing).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Process</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#State">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Stative"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty>
        <rdf:Description>
          <owl:inverseOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#partOf"/>
        </rdf:Description>
      </owl:onProperty>
      <owl:allValuesFrom rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#State"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">states</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A State is a stative perdurant such that all its parts are of the same type (examples: being sitting, being open, being happy, being red).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">State</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">states</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">state</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A State is a stative perdurant such that all its parts are of the same type (examples: being sitting, being open, being happy, being red).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">State</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#SocialAgent">
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Society"/>
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  <rdfs:subClassOf rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#AgentiveSocialObject"/>
  <owl:disjointWith rdf:resource="https://w3id.org/DOLCE/OWL/DOLCEbasic#Society"/>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social agents</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social agent</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Social Agent is an individual agentive social object (examples: a teacher, a president, a software agent).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Agent</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social agents</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">social agent</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Social Agent is an individual agentive social object (examples: a teacher, a president, a software agent).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Social Agent</rdfs:label>
</owl:Class>

<owl:Class rdf:about="https://w3id.org/DOLCE/OWL/DOLCEbasic#Society">
