  </rdfs:subClassOf>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">space regions</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">space region</ace_:CN_sg>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">A Space Region is a physical region, possibly disconnected, for spatial locations (examples: the region occupied by Earth in this moment, the region where it snowed in the year 1900).</rdfs:comment>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Space Region</rdfs:label>
  <ace_:CN_pl rdf:datatype="http://www.w3.org/2001/XMLSchema#string">space regions</ace_:CN_pl>
  <ace_:CN_sg rdf:datatype="http://www.w3.org/2001/XMLSchema#string">space region</ace_:CN_sg>
