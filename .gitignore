# ==============================================================================
# --- Regras específicas do projeto MORE (com base no system/.gitignore) ---
# ==============================================================================
# Ignorar arquivos muito grandes de ontologia em qualquer diretório (como etl_movielens/ e system/ontology/)
*.owl
# Permitir apenas as ontologias base da aplicação que devem ir ao GitHub
!system/ontology/moreo_ontology.ttl
!system/ontology/moreo_shacl.ttl
# Ignorar dependências, ambientes virtuais e scripts de rascunho de dentro da pasta system
system/venv/
system/.venv/
system/env/
system/__pycache__/
system/scratch/
system/users_subgraph/
system/models/model.pt
system/models/*.pt
system/graficos/
# Ignorar builds, caches e pacotes locais do Flutter Web
system/frontend/.dart_tool/
system/frontend/.packages
system/frontend/.pub-cache/
system/frontend/.pub/
system/frontend/build/
system/frontend/build_info.json
system/frontend/pubspec.lock
